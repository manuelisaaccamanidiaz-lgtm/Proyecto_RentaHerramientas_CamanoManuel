# Copiar a .env y ajustar. Lo leen docker-compose y application.yml (perfil dev).

# Base de datos. POSTGRES_HOST/PORT se usan al ejecutar la app SIN Docker;
# dentro de docker compose la app siempre usa postgres:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rentaherramientas
POSTGRES_USER=renta_user
POSTGRES_PASSWORD=cambia_esta_clave

# dev = datos semilla y logs SQL · prod = sin semilla y sin valores por defecto.
SPRING_PROFILES_ACTIVE=dev

# Puerto publicado de la app en docker compose (http://localhost:8080).
APP_PORT=8080

# JWT (HS256): el secreto debe tener al menos 32 bytes. Generar uno con: openssl rand -base64 48
JWT_SECRET=cambia_este_secreto_por_uno_aleatorio_de_al_menos_32_bytes
JWT_EXPIRACION_MINUTOS=60

# Administrador inicial: se crea al arrancar si el email no existe. Dejar vacío para no crearlo.
ADMIN_EMAIL=admin@rentaherramientas.local
ADMIN_PASSWORD=cambia_esta_clave_admin

# Orígenes permitidos por CORS (separados por coma). El frontend incluido es del
# mismo origen y no lo necesita; sirve para clientes externos (p. ej. Vite en 5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Imágenes de herramientas: directorio local (se publican como /uploads/<archivo>).
# En Docker se ignora: la app usa /uploads, montado como volumen.
UPLOADS_DIR=./uploads
