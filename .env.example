# Copiar a .env y ajustar. Lo leen docker-compose y application.yml (perfil dev).
#
# Formato: una variable por línea, NOMBRE=valor, sin espacios alrededor del "=" y sin
# comillas. Los comentarios van solo en líneas propias que empiezan por "#": un "#" al
# final de un valor puede terminar formando parte del valor.
# El .env real contiene secretos: no se sube al repositorio (está en .gitignore) ni entra
# en la imagen (está en .dockerignore). Este archivo solo trae valores de ejemplo.
# Las variables definidas en la terminal tienen prioridad sobre las de .env.

# Base de datos. POSTGRES_HOST/PORT se usan al ejecutar la app SIN Docker;
# dentro de docker compose la app siempre usa postgres:5432.
# POSTGRES_PORT también es el puerto publicado en el host: cámbialo si 5432 está ocupado.
# DB, USER y PASSWORD solo se aplican al crear el volumen por primera vez; si los cambias
# después, borra el volumen con "docker compose down -v" (se pierden los datos).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rentaherramientas
POSTGRES_USER=renta_user
POSTGRES_PASSWORD=cambia_esta_clave

# dev = datos semilla y logs SQL · prod = sin semilla y sin valores por defecto.
SPRING_PROFILES_ACTIVE=dev

# Puerto publicado de la app en docker compose (http://localhost:8080).
# Si 8080 está ocupado usa otro (p. ej. 8081) y abre http://localhost:8081.
APP_PORT=8080

# JWT (HS256): el secreto debe tener al menos 32 bytes. Generar uno con: openssl rand -base64 48
# Si cambias el secreto, los tokens emitidos antes dejan de ser válidos (hay que volver
# a iniciar sesión).
JWT_SECRET=cambia_este_secreto_por_uno_aleatorio_de_al_menos_32_bytes
JWT_EXPIRACION_MINUTOS=60

# Administrador inicial: se crea al arrancar si el email no existe. Dejar vacío para no crearlo.
ADMIN_EMAIL=admin@rentaherramientas.local
ADMIN_PASSWORD=cambia_esta_clave_admin

# Orígenes permitidos por CORS (separados por coma). El frontend incluido es del
# mismo origen y no lo necesita; sirve para clientes externos (p. ej. Vite en 5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Imágenes de herramientas: directorio local (se publican como /uploads/<archivo>).
# En Docker se ignora: la app usa /uploads, montado como volumen.
UPLOADS_DIR=./uploads

# Opcional, no incluida arriba: RESERVAS_CRON_VENCIMIENTO define cuándo se revisan las
# reservas vencidas. Es un cron de Spring con 6 campos (seg min hora día mes día_semana);
# si no se define, docker-compose usa "0 5 0 * * *" (todos los días a las 00:05).
