{
  "info": {
    "name": "Renta de Herramientas API",
    "description": "Peticiones de los Días 2 y 3. Orden sugerido: 1) Registro, 2) Login de cada rol (cada login guarda su token en una variable de colección), 3) resto de carpetas.\n\nVariables: baseUrl, adminEmail/adminPassword (los de ADMIN_EMAIL/ADMIN_PASSWORD del .env), tokenAdmin/tokenProveedor/tokenCliente (se rellenan solos), categoriaId, herramientaId y usuarioId (se rellenan al crear).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminEmail", "value": "admin@rentaherramientas.local" },
    { "key": "adminPassword", "value": "cambia_esta_clave_admin" },
    { "key": "proveedorEmail", "value": "proveedor@test.com" },
    { "key": "clienteEmail", "value": "cliente@test.com" },
    { "key": "password", "value": "Password123" },
    { "key": "tokenAdmin", "value": "" },
    { "key": "tokenProveedor", "value": "" },
    { "key": "tokenCliente", "value": "" },
    { "key": "categoriaId", "value": "1" },
    { "key": "herramientaId", "value": "1" },
    { "key": "usuarioId", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Registro PROVEEDOR",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/registro",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ferretería Uno\",\n  \"email\": \"{{proveedorEmail}}\",\n  \"password\": \"{{password}}\",\n  \"rol\": \"PROVEEDOR\",\n  \"datosProveedor\": { \"razonSocial\": \"Ferretería Uno SAS\", \"nit\": \"900123456-7\" }\n}" }
          }
        },
        {
          "name": "Registro CLIENTE",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/registro",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana Cliente\",\n  \"email\": \"{{clienteEmail}}\",\n  \"password\": \"{{password}}\",\n  \"rol\": \"CLIENTE\",\n  \"datosCliente\": { \"documento\": \"1020304050\", \"telefono\": \"3001234567\", \"direccion\": \"Calle 1 # 2-3\" }\n}" }
          }
        },
        {
          "name": "Login ADMIN",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) { pm.collectionVariables.set('tokenAdmin', pm.response.json().token); }"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }
          }
        },
        {
          "name": "Login PROVEEDOR",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) { pm.collectionVariables.set('tokenProveedor', pm.response.json().token); }"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{proveedorEmail}}\",\n  \"password\": \"{{password}}\"\n}" }
          }
        },
        {
          "name": "Login CLIENTE",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) { pm.collectionVariables.set('tokenCliente', pm.response.json().token); }"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clienteEmail}}\",\n  \"password\": \"{{password}}\"\n}" }
          }
        },
        {
          "name": "Login con password incorrecto (401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{proveedorEmail}}\",\n  \"password\": \"incorrecta123\"\n}" }
          }
        }
      ]
    },
    {
      "name": "2. Mi perfil",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProveedor}}", "type": "string" }] },
      "item": [
        {
          "name": "GET /api/usuarios/me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/usuarios/me" }
        },
        {
          "name": "PUT /api/usuarios/me (proveedor)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/usuarios/me",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ferretería Uno Editada\",\n  \"datosProveedor\": { \"razonSocial\": \"Ferretería Uno SAS\", \"nit\": \"900123456-7\" }\n}" }
          }
        }
      ]
    },
    {
      "name": "3. Categorías",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdmin}}", "type": "string" }] },
      "item": [
        {
          "name": "Listar (público)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/categorias" }
        },
        {
          "name": "Detalle (público)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/categorias/{{categoriaId}}" }
        },
        {
          "name": "Crear (ADMIN)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) { pm.collectionVariables.set('categoriaId', pm.response.json().id); }"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/categorias",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Taladros\",\n  \"descripcion\": \"Taladros percutores e inalámbricos\"\n}" }
          }
        },
        {
          "name": "Actualizar (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/categorias/{{categoriaId}}",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Taladros\",\n  \"descripcion\": \"Percutores, rotomartillos e inalámbricos\"\n}" }
          }
        },
        {
          "name": "Eliminar (ADMIN; 409 si está en uso)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/categorias/{{categoriaId}}" }
        }
      ]
    },
    {
      "name": "4. Herramientas",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProveedor}}", "type": "string" }] },
      "item": [
        {
          "name": "Catálogo con filtros (público)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/herramientas?categoriaId={{categoriaId}}&estado=DISPONIBLE&texto=taladro&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "herramientas"],
              "query": [
                { "key": "categoriaId", "value": "{{categoriaId}}" },
                { "key": "estado", "value": "DISPONIBLE" },
                { "key": "texto", "value": "taladro" },
                { "key": "proveedorId", "value": "", "disabled": true },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Detalle (público)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/herramientas/{{herramientaId}}" }
        },
        {
          "name": "Registrar (PROVEEDOR)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) { pm.collectionVariables.set('herramientaId', pm.response.json().id); }"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/herramientas",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Taladro percutor Bosch 800W\",\n  \"descripcion\": \"Incluye maletín y juego de brocas\",\n  \"tarifaDiaria\": 25000,\n  \"moneda\": \"COP\",\n  \"categoriaIds\": [{{categoriaId}}]\n}" }
          }
        },
        {
          "name": "Registrar como CLIENTE (403)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('403', () => pm.response.to.have.status(403));"
          ] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenCliente}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/herramientas",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"No debería crearse\",\n  \"tarifaDiaria\": 1000,\n  \"categoriaIds\": [{{categoriaId}}]\n}" }
          }
        },
        {
          "name": "Actualizar (dueño o ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/herramientas/{{herramientaId}}",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Taladro percutor Bosch 850W\",\n  \"descripcion\": \"Incluye maletín, brocas y nivel\",\n  \"tarifaDiaria\": 28000,\n  \"categoriaIds\": [{{categoriaId}}]\n}" }
          }
        },
        {
          "name": "Cambiar estado (dueño o ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/herramientas/{{herramientaId}}/estado",
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"EN_MANTENIMIENTO\"\n}" }
          }
        },
        {
          "name": "Eliminar = inactivar (dueño o ADMIN)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/herramientas/{{herramientaId}}" }
        },
        {
          "name": "Mi inventario (PROVEEDOR)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/proveedor/herramientas?page=0&size=20" }
        }
      ]
    },
    {
      "name": "5. Imágenes de herramientas",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProveedor}}", "type": "string" }] },
      "item": [
        {
          "name": "Subir imagen (campo \"archivo\": JPEG/PNG/WebP ≤ 5 MB)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/herramientas/{{herramientaId}}/imagenes",
            "body": { "mode": "formdata", "formdata": [{ "key": "archivo", "type": "file", "src": "" }] },
            "description": "Selecciona el archivo en la pestaña Body. La respuesta trae la URL pública en imagenes[].url."
          }
        },
        {
          "name": "Quitar imagen por orden",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/herramientas/{{herramientaId}}/imagenes/1" }
        }
      ]
    },
    {
      "name": "6. Administración de usuarios (ADMIN)",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdmin}}", "type": "string" }] },
      "item": [
        {
          "name": "Listar por rol (paginado)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const c = pm.response.json().contenido;",
            "if (c && c.length) { pm.collectionVariables.set('usuarioId', c[0].id); }"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/usuarios?rol=PROVEEDOR&page=0&size=20" }
        },
        {
          "name": "Detalle",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/usuarios/{{usuarioId}}" }
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/usuarios/{{usuarioId}}",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Nombre corregido por ADMIN\",\n  \"datosProveedor\": { \"razonSocial\": \"Ferretería Uno SAS\", \"nit\": \"900123456-7\" }\n}" }
          }
        },
        {
          "name": "Desactivar",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/admin/usuarios/{{usuarioId}}/desactivar" }
        },
        {
          "name": "Activar",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/admin/usuarios/{{usuarioId}}/activar" }
        }
      ]
    }
  ]
}
